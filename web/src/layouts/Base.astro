---
import '../styles/global.css';
import forecast from '../data/forecast.json';

const { title = 'Senaste valprognosen för riksdagsvalet 2026 | Trefyranio', description =
  'Senaste valprognosen för riksdagsvalet 2026: en statistisk modell väger samman alla nya opinionsmätningar (Sifo, Novus, Ipsos m.fl.) och simulerar valet tusentals gånger – sannolikheter för mandat, regering och fyraprocentsspärren.', schema } = Astro.props;
const updated = forecast.updated;
const GA_ID = 'G-Z0GZ8QSCJH';

// Canonical URL, normalized to the no-trailing-slash form Firebase serves 200 on.
// Done explicitly rather than relying on astro.config's trailingSlash affecting
// Astro.url at build time — a self-referential canonical that 301s is worth
// pinning down deterministically.
const canonicalPath = Astro.url.pathname.replace(/(.)\/$/, '$1');
const canonical = new URL(canonicalPath, 'https://trefyran.io').href;

// The eight party pages are otherwise orphaned: nothing linked to /parti/*, so
// the only page Google crawls had no path to them. Linked site-wide, not just
// from the homepage.
const partyLinks = forecast.parties
  .filter((p) => p.code !== 'Övr')
  .map((p) => ({ href: `/parti/${p.code.toLowerCase()}`, code: p.code, name: p.name }));
---
<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`https://trefyran.io/og.png?v=${updated}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`https://trefyran.io/og.png?v=${updated}`} />
    {schema && schema.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
    {import.meta.env.PROD && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
        <script is:inline define:vars={{ GA_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', GA_ID);
        </script>
      </>
    )}
  </head>
  <body>
    <header class="site-head">
      <div class="wrap head-row">
        <a class="brand" href="/">
          <img src="/logo.png" alt="" width="128" height="128" />
          <span class="wordmark">trefyra<span class="dot">nio</span></span>
        </a>
        <nav class="nav">
          <a href="/">Prognos</a>
          <a href="/metod">Metod</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap">
        <nav class="foot-nav">
          <a href="/">Prognos</a>
          <a href="/vem-blir-statsminister">Vem blir statsminister</a>
          <a href="/koalitioner">Möjliga regeringar</a>
          <a href="/mandatkarta">Mandat per valkrets</a>
          <a href="/fyraprocentssparren">Fyraprocentsspärren</a>
          <a href="/ordlista">Ordlista</a>
          <a href="/metod">Metod</a>
          <a href="/code">Källkod</a>
        </nav>
        <nav class="foot-nav foot-parties" aria-label="Partiprognoser">
          {partyLinks.map((p) => (
            <a href={p.href}>{p.name}</a>
          ))}
        </nav>
        <p>Uppdaterad {updated}. Prognosmodell trefyranio, av Krukis Data Science.</p>
        <p class="faint">Data: Valmyndigheten, SCB, SwedishPolls.
          Detta är en statistisk prognos, inte en förutsägelse.</p>
      </div>
    </footer>
    <style>
      .site-head { border-bottom: 1px solid var(--rule); }
      .head-row { display: flex; align-items: center; justify-content: space-between; padding: 12px 0; }
      .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--ink); }
      .brand img { width: 128px; height: 128px; }     /* desktop (+50%) */
      .wordmark { font-weight: 900; font-size: 28px; letter-spacing: -0.02em; }
      @media (max-width: 560px) {
        .brand img { width: 66px; height: 66px; }      /* mobile (+30%) */
        .wordmark { font-size: 22px; }
      }
      .wordmark .dot { color: var(--muted); font-weight: 700; }
      .nav a { color: var(--muted); text-decoration: none; font-weight: 600; font-size: 14px; margin-left: 18px; }
      .nav a:hover { color: var(--ink); }
      .site-foot { margin-top: 40px; border-top: 1px solid var(--grid); padding: 24px 0 60px; }
      .site-foot p { margin: 0 0 6px; font-size: 13px; color: var(--muted); }
      .foot-nav { display: flex; flex-wrap: wrap; gap: 16px; margin-bottom: 16px; }
      .foot-nav a { color: var(--ink); text-decoration: none; font-weight: 700; font-size: 14px; }
      .foot-nav a:hover { text-decoration: underline; }
      .foot-parties { gap: 14px; margin-top: -4px; }
      .foot-parties a { font-weight: 400; font-size: 13px; color: var(--muted); }
    </style>
  </body>
</html>
